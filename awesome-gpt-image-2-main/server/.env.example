# 环境变量配置说明
# 复制此文件为 .env 并填入真实值

# Lingke API 配置
LINGKE_API_KEY=your_lingke_api_key_here
LINGKE_BASE_URL=https://api.lingke.com

# 微信支付配置
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_API_V3_KEY=your_wechat_api_v3_key
WECHAT_SERIAL_NO=your_wechat_serial_no
WECHAT_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/payments/wechat/notify

# 支付宝配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/payments/success

# 服务器配置
PORT=3000
